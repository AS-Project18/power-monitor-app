<Window x:Class="PowerMonitorApp.Tray.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riwayat Pemakaian"
        Height="680" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF181818">
    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="📊" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="Riwayat Pemakaian" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SubHeaderText" Text="-" FontSize="11" Foreground="#FF888888" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="DailyTabButton" Content="Harian" Style="{StaticResource TabButton}"
                    Margin="0,0,4,0" Click="DailyTabButton_Click"/>
            <Button Grid.Column="1" x:Name="MonthlyTabButton" Content="Bulanan" Style="{StaticResource TabButton}"
                    Margin="4,0,0,0" Click="MonthlyTabButton_Click"/>
        </Grid>

        <Border Grid.Row="2" x:Name="SummaryCard" Background="#FF16344A" CornerRadius="10" Padding="18,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL kWh" Foreground="#FFB0DFFF" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalKwhText" Text="0.0000" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="TOTAL BIAYA" Foreground="#FFB0DFFF" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalCostText" Text="Rp 0" Foreground="#FF4FC3F7" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="AverageLabelText" Text="RATA-RATA/HARI" Foreground="#FFB0DFFF" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AverageKwhText" Text="0.0000 kWh" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" x:Name="ChartCard" Background="#FF232323" CornerRadius="10" Padding="18,16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="ChartTitleText" Text="TREN kWh PER HARI" Foreground="#FF9E9E9E" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ChartItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="34" Margin="3,0" ToolTip="{Binding Tooltip}">
                                    <TextBlock Text="{Binding ValueLabel}" FontSize="9" Foreground="#FF6FB8E8"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Grid Height="130" VerticalAlignment="Bottom">
                                        <Border Height="{Binding Height}" Width="18" Background="#FF4FC3F7"
                                                CornerRadius="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#FF888888"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <TextBlock x:Name="EmptyStateText"
                       Text="Belum ada data pemakaian.&#x0a;Riwayat akan muncul di sini setelah aplikasi berjalan beberapa saat."
                       Foreground="#FF666666" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

            <ScrollViewer x:Name="ListScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF232323" CornerRadius="8" Padding="16,13" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                                        <TextBlock Text="{Binding KwhLabel}" Foreground="#FF9E9E9E" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CostLabel}" Foreground="#FF4FC3F7" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
