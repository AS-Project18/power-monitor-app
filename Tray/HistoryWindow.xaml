<Window x:Class="PowerMonitorApp.Tray.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riwayat Pemakaian"
        Height="690" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource AsproGhostButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,9"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentGradientBrush}">
                <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Riwayat Pemakaian" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock x:Name="SubHeaderText" Text="-" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="DailyTabButton" Content="Harian" Style="{StaticResource TabButton}"
                    Margin="0,0,4,0" Click="DailyTabButton_Click"/>
            <Button Grid.Column="1" x:Name="MonthlyTabButton" Content="Bulanan" Style="{StaticResource TabButton}"
                    Margin="4,0,0,0" Click="MonthlyTabButton_Click"/>
        </Grid>

        <Border Grid.Row="2" x:Name="SummaryCard" Background="{StaticResource SelectedBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL kWh" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalKwhText" Text="0.0000" Foreground="{StaticResource PrimaryTextBrush}" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="TOTAL BIAYA" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalCostText" Text="Rp 0" Foreground="{StaticResource AccentSoftBrush}" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="AverageLabelText" Text="RATA-RATA/HARI" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AverageKwhText" Text="0.0000 kWh" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" x:Name="ChartCard" Style="{StaticResource AsproCard}" Padding="18,16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="ChartTitleText" Text="TREN kWh PER HARI" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ChartItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="34" Margin="3,0" ToolTip="{Binding Tooltip}">
                                    <TextBlock Text="{Binding ValueLabel}" FontSize="9" Foreground="{StaticResource AccentSoftBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Grid Height="130" VerticalAlignment="Bottom">
                                        <Border Height="{Binding Height}" Width="18" Background="{StaticResource AccentGradientBrush}"
                                                CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <TextBlock x:Name="EmptyStateText"
                       Text="Belum ada data pemakaian.&#x0a;Riwayat akan muncul di sini setelah aplikasi berjalan beberapa saat."
                       Foreground="{StaticResource DisabledTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

            <ScrollViewer x:Name="ListScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AsproCard}" Padding="16,13" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding KwhLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CostLabel}" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
