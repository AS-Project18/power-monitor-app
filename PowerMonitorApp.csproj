<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>PowerMonitorApp</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <Version>1.0.0</Version>
    <Product>PC Power Monitor</Product>
    <AssemblyTitle>PC Power Monitor</AssemblyTitle>
    <Authors>AS Project</Authors>
    <Description>Tray app estimasi konsumsi daya PC (CPU + GPU) dan biaya listriknya.</Description>
  </PropertyGroup>

  <!--
    Pengaturan di bawah cuma berlaku saat `dotnet publish` (lihat README bagian
    "Build rilis"), supaya `dotnet build`/`dotnet run` biasa buat development
    tetap ringan dan tidak framework-dependent-only.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Akses sensor power CPU/GPU (RAPL, NVML, dll) -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Penyimpanan histori pembacaan daya -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
