<Window x:Class="PowerMonitorApp.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan"
        Height="600" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF181818">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9E9E9E"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF141414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4FC3F7"/>
            <Setter Property="Foreground" Value="#FF0A0A0A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF7FD4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF383838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="⚙" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Text="Pengaturan" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FF232323" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="💰 TARIF LISTRIK" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Tarif per kWh (Rp)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="TariffBox" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Border>

                <Border Background="#FF232323" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🖥 ESTIMASI CPU" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Daya maksimum saat boost (W)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="CpuTdpBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>
                        <TextBlock Text="Daya idle (W)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="CpuIdleFloorBox" Style="{StaticResource DarkTextBox}"/>
                        <TextBlock Text="Estimasi watt CPU (kalau sensor Power tidak terbaca — lihat Diagnostik Sensor) diinterpolasi antara Daya idle dan Daya maksimum berdasarkan load core tersibuk. Daya maksimum boleh lebih tinggi dari TDP resmi (AMD sering boost sampai ~1.3x TDP)."
                                   Style="{StaticResource HelperText}"/>
                    </StackPanel>
                </Border>

                <Border Background="#FF232323" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="⏱ MONITORING" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Interval polling (detik)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="PollingIntervalBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>
                        <TextBlock Text="Retensi data histori (hari, 0 = tidak pernah dihapus)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="RetentionBox" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="#FFE57373" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Batal" Width="90" Margin="0,0,10,0" Style="{StaticResource GhostButton}" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Simpan" Width="90" Style="{StaticResource PrimaryButton}" Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
