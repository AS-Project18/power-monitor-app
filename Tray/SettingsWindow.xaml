<Window x:Class="PowerMonitorApp.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan"
        Height="610" Width="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" Background="{StaticResource AccentGradientBrush}" CornerRadius="10">
                <TextBlock Text="⚙" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Pengaturan" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Konfigurasi monitoring daya" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource AsproCard}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TARIF LISTRIK" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Tarif per kWh (Rp)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="TariffBox" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AsproCard}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ESTIMASI CPU" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Daya maksimum saat boost (W)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="CpuTdpBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>
                        <TextBlock Text="Daya idle (W)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="CpuIdleFloorBox" Style="{StaticResource DarkTextBox}"/>
                        <TextBlock Text="Estimasi watt CPU (kalau sensor Power tidak terbaca — lihat Diagnostik Sensor) diinterpolasi antara Daya idle dan Daya maksimum berdasarkan load core tersibuk. Daya maksimum boleh lebih tinggi dari TDP resmi (AMD sering boost sampai ~1.3x TDP)."
                                   Style="{StaticResource HelperText}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AsproCard}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MONITORING" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Interval polling (detik)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="PollingIntervalBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>
                        <TextBlock Text="Retensi data histori (hari, 0 = tidak pernah dihapus)" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="RetentionBox" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Batal" Width="90" Margin="0,0,10,0" Style="{StaticResource AsproGhostButton}" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Simpan" Width="90" Style="{StaticResource AsproPrimaryButton}" Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
