<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!--
          LibreHardwareMonitorLib butuh akses driver kernel (WinRing0) untuk
          membaca sensor RAPL/MSR pada CPU dan sebagian sensor GPU.
          Tanpa admin, sebagian sensor power bisa gagal terbaca (bernilai null).
        -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
